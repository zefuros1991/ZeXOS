# caches and runtime data
.cache/
.local/cache/
.local/state/
.var/
**/cache/

# OS junk
*.log
*.tmp
*.bak
*.swp
.Trash-*
.zcompdump*

# stow backups and stray root symlink (machine-local, never commit)
backup/
/.config

# app data that isn't config (caches, cookies, session state)
**/Cache/
**/CachedData/
**/GPUCache/
**/Session Storage/
**/Local Storage/
**/IndexedDB/
**/Cookies*
**/Singleton*

# made by finaltouches.sh at install time (absolute links to the system's
# adw-gtk3 theme, which stow refuses to deploy)
stow/theme/.config/gtk-4.0/assets
stow/theme/.config/gtk-4.0/gtk-dark.css

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# written at run time by zshell and DankMaterialShell (per user, per machine)
stow/kitty/.config/kitty/themes/shell.conf
stow/kitty/.config/kitty/dank-theme.conf
stow/niri/.config/niri/shell-colors.kdl
stow/niri/.config/niri/dms/
stow/mango/.config/mango/shell-colors.conf
stow/mango/.config/mango/noctalia.conf
stow/mango/.config/mango/dms/
stow/hyprland/.config/hypr/shell-colors.lua
stow/hyprland/.config/hypr/noctalia.lua
stow/hyprland/.config/hypr/dms/
stow/hyprland/.config/hypr/.dms-backups/
stow/theme/.config/gtk-3.0/shell.css
stow/theme/.config/gtk-4.0/shell.css
stow/theme/.config/gtk-3.0/dank-colors.css
stow/theme/.config/gtk-4.0/dank-colors.css
stow/fuzzel/.config/fuzzel/themes/shell
stow/fuzzel/.config/fuzzel/themes/dank
stow/btop/.config/btop/themes/shell.theme
stow/btop/.config/btop/themes/dank.theme
