#!/usr/bin/env bash
# Puts ZeXOS on a freshly installed Arch system that is still mounted
# (at /mnt after archinstall, or wherever Calamares mounted it), before its
# first boot. Both installer ISOs end with this.
#
#   zexos-install-into <root> <user>
#
# ZEXOS_COMPOSITORS and ZEXOS_SHELLS (space separated, e.g. "niri mango"
# and "noctalia") pick what gets installed; unset means everything.
#
# It runs the normal ZeXOS install.sh inside the new system as <user>, the
# same way you would after logging in. install.sh needs sudo without a
# prompt here, so a temporary sudoers file allows that, and is always
# removed again afterwards. Before that it names the system ZeXOS.
set -euo pipefail

ROOT="${1:?usage: zexos-install-into <root> <user>}"
USERNAME="${2:?usage: zexos-install-into <root> <user>}"

# The branch the ISO was built for (main unless it is a test ISO).
ZEXOS_BRANCH=main
[ -f /etc/zexos-iso.conf ] && . /etc/zexos-iso.conf

if [ ! -f "$ROOT/etc/os-release" ]; then
    echo "No installed system found at $ROOT. Is it mounted?" >&2
    exit 1
fi
home="$(awk -F: -v u="$USERNAME" '$1 == u { print $6 }' "$ROOT/etc/passwd")"
if [ -z "$home" ]; then
    echo "There is no user called $USERNAME in the new system." >&2
    exit 1
fi

log="$ROOT/var/log/zexos-install.log"
exec > >(tee -a "$log") 2>&1

dropin="$ROOT/etc/sudoers.d/99-zexos-installer"
cleanup() { rm -f "$dropin"; }
trap cleanup EXIT

# The new system needs git and curl to fetch ZeXOS, and sudo for the
# installer itself (a minimal install can leave them out).
arch-chroot "$ROOT" pacman -S --needed --noconfirm git curl sudo

# A ZeXOS installed from the ISO is a full distro, so it comes with what most
# Arch-based distros ship (CachyOS, EndeavourOS, Manjaro): Firefox as the web
# browser, and fish as the user's shell, like CachyOS. The ZeXOS terminal
# look works the same in fish. Script installs on another distro keep theirs.
arch-chroot "$ROOT" pacman -S --needed --noconfirm firefox fish
arch-chroot "$ROOT" chsh -s /usr/bin/fish "$USERNAME"

# Name the new system ZeXOS (it says ID_LIKE=arch, so everything still
# treats it as Arch), and keep that name after updates.
brand=/usr/local/share/zexos/branding
install -Dm755 "$brand/zexos-branding" "$ROOT/usr/local/bin/zexos-branding"
install -Dm644 "$brand/zexos-branding.hook" "$ROOT/etc/pacman.d/hooks/zexos-branding.hook"
arch-chroot "$ROOT" /usr/local/bin/zexos-branding

# NOPASSWD alone is not enough: "sudo -v" still asks unless every rule
# that matches the user skips authentication, and %wheel ALL does not.
mkdir -p "$ROOT/etc/sudoers.d"
printf '%s ALL=(ALL:ALL) NOPASSWD: ALL\nDefaults:%s !authenticate\n' "$USERNAME" "$USERNAME" > "$dropin"
chmod 440 "$dropin"

# install.sh draws on the terminal, so give it a real one even when this
# runs unattended (no TERM, or "dumb").
case "${TERM:-dumb}" in dumb) TERM=linux ;; esac

url="https://raw.githubusercontent.com/zefuros1991/ZeXOS/$ZEXOS_BRANCH/install.sh"
arch-chroot "$ROOT" runuser -u "$USERNAME" -- env -i \
    HOME="$home" USER="$USERNAME" LOGNAME="$USERNAME" SHELL=/bin/bash \
    PATH=/usr/local/sbin:/usr/local/bin:/usr/bin \
    TERM="$TERM" LANG="${LANG:-C.UTF-8}" \
    ZEXOS_PACKAGES=prebuilt ZEXOS_BRANCH="$ZEXOS_BRANCH" \
    ZEXOS_COMPOSITORS="${ZEXOS_COMPOSITORS:-}" ZEXOS_SHELLS="${ZEXOS_SHELLS:-}" \
    bash -c 'cd "$HOME" && curl -fsSL "$0" -o /tmp/zexos-install.sh && bash /tmp/zexos-install.sh; rc=$?; rm -f /tmp/zexos-install.sh; exit $rc' "$url"

# First login: niri with Noctalia, the same desktop as the live ISO (Noctalia
# is zshell's default already). The login screen preselects the session saved
# in its state file, and with none it picks the first alphabetically
# (Hyprland). After that it remembers whatever you pick.
niri=/usr/share/wayland-sessions/niri.desktop
if [ -f "$ROOT$niri" ] && [ -d "$ROOT/var/lib/sddm" ] && [ ! -s "$ROOT/var/lib/sddm/state.conf" ]; then
    printf '[Last]\nUser=%s\nSession=%s\n' "$USERNAME" "$niri" > "$ROOT/var/lib/sddm/state.conf"
    arch-chroot "$ROOT" chown sddm:sddm /var/lib/sddm/state.conf
fi

echo "ZeXOS is installed for $USERNAME. Log: /var/log/zexos-install.log"
