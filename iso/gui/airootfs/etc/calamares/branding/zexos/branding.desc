# ZeXOS look for Calamares. Images (logo, slides, previews) are generated
# by iso/gui/customize.sh when the ISO is built.
---
componentName:  zexos
welcomeStyleCalamares: false
welcomeExpandingLogo: false
# noexpand: a page that doesn't fit (the Summary) scrolls inside the window
# instead of growing it past the bottom of the screen, which hid the
# Install button.
windowExpanding: noexpand
windowSize: 1180px,720px
windowPlacement: center
sidebar: qml,left
navigation: widget

strings:
    productName:         ZeXOS
    shortProductName:    ZeXOS
    version:             @VERSION@
    shortVersion:        @VERSION@
    versionedName:       ZeXOS @VERSION@
    shortVersionedName:  ZeXOS @VERSION@
    bootloaderEntryName: ZeXOS
    productUrl:          https://github.com/zefuros1991/ZeXOS
    supportUrl:          https://github.com/zefuros1991/ZeXOS/issues
    knownIssuesUrl:      https://github.com/zefuros1991/ZeXOS/issues

images:
    productLogo:         "logo.png"
    productIcon:         "icon.png"
    productWelcome:      "welcome.png"

style:
   SidebarBackground:        "#14141c"
   SidebarText:              "#9a9ab0"
   SidebarTextCurrent:       "#ffffff"
   SidebarBackgroundCurrent: "#7C5CFF"

slideshow:    "show.qml"
slideshowAPI: 2
