/* ZeXOS: dark, rounded, violet accent. Colours match docs/index.html. */
/* Don't lean on the desktop's Qt colours (qt6ct can fail to load after a Qt
   update): plain-widget pages like Summary and Partitions get theirs here.
   Kept first so every rule below still wins. */
QWidget { background: #0f0f14; color: #e6e6ef; }
QLabel { background: transparent; }
QLabel[autoFillBackground="true"] { background: #1a1a24; border-radius: 6px; }
QWidget { font: 13px "Noto Sans"; }
#mainApp, #mainApp QWidget#page_partition, QStackedWidget { background: #0f0f14; }
QLabel { color: #e6e6ef; }
QPushButton {
    background: #1a1a24; color: #e6e6ef;
    border: 1px solid #2a2a38; border-radius: 8px; padding: 7px 18px;
}
QPushButton:hover { border-color: #a78bfa; }
QPushButton:default, QPushButton#view-button-next {
    background: #7C5CFF; border-color: #7C5CFF; color: #ffffff;
}
QPushButton:disabled { color: #5a5a6e; background: #15151d; border-color: #20202a; }
QLineEdit, QComboBox, QSpinBox, QListView, QTreeView, QTableView {
    background: #1a1a24; color: #e6e6ef; selection-background-color: #7C5CFF;
    border: 1px solid #2a2a38; border-radius: 6px; padding: 5px;
}
QLineEdit:focus, QComboBox:focus { border-color: #a78bfa; }
QRadioButton, QCheckBox { color: #e6e6ef; spacing: 8px; }
QProgressBar {
    background: #1a1a24; border: none; border-radius: 4px; height: 8px; color: transparent;
}
QProgressBar::chunk {
    border-radius: 4px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #7C5CFF, stop:0.5 #B45CE6, stop:1 #3DDC97);
}
QScrollBar:vertical { background: transparent; width: 10px; }
QScrollBar::handle:vertical { background: #2a2a38; border-radius: 5px; min-height: 30px; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; }
QDialogButtonBox { dialogbuttonbox-buttons-have-icons: 0; }
#debugButton { background: none; border: none; color: #5a5a6e; font: 9px; padding: 0; }
#aboutButton { background: none; border: none; font: 14px; }
QHeaderView::section { background: #1a1a24; color: #9a9ab0; border: none; padding: 4px; }
QComboBox QAbstractItemView, QMenu { background: #1a1a24; color: #e6e6ef; }
/* Partitions page: bigger, easy-to-read choices in the middle of the window. */
#ChoicePage QLabel, #ChoicePage QRadioButton, #ChoicePage QComboBox,
#ChoicePage QCheckBox { font: 16px "Noto Sans"; }
#ChoicePage QRadioButton { spacing: 16px; }
#ChoicePage Calamares--Widgets--PrettyRadioButton { min-width: 820px; max-width: 820px; }
QRadioButton::indicator {
    width: 14px; height: 14px; border-radius: 9px;
    border: 2px solid #3a3a4c; background: #1a1a24;
}
QRadioButton::indicator:hover { border-color: #a78bfa; }
QRadioButton::indicator:checked { border: 4px solid #7C5CFF; background: #e6e6ef; width: 10px; height: 10px; }
/* Summary page: a centred column of cards, one per step. */
#summaryContent { max-width: 900px; }
#summaryTitle {
    font-size: 26px; font-weight: 700; color: #ffffff;
    padding: 18px 40px 12px 40px; qproperty-alignment: AlignCenter; qproperty-wordWrap: true;
}
#summaryItemTitle {
    font-size: 14px; font-weight: 700; color: #a78bfa;
    padding: 14px 4px 6px 4px;
}
#summaryItem { background: #1a1a24; border: 1px solid #22222e; border-radius: 12px; }
#summaryItem QWidget { background: transparent; }
#summaryItem QLabel { font-size: 15px; }
/* Welcome page: a centred block; the language picker isn't full width. */
#languageWidget { min-width: 360px; max-width: 480px; }
#mainText { font-size: 16px; }
/* Location page: slightly bigger text in the block under the map. */
#localeBlock QLabel, #localeBlock QComboBox { font-size: 15px; }
/* Keyboard page: shorter lists and narrower rows, centred (Calamares patch). */
#layoutSelector, #variantSelector { min-width: 360px; max-width: 440px; max-height: 300px; font-size: 14px; }
#physicalModelSelector { min-width: 360px; max-width: 560px; }
#LE_TestKeyboard { min-width: 360px; max-width: 520px; }
#Page_Keyboard QLabel { font-size: 15px; }
#buttonRestore { max-width: 44px; }
#groupSelector { min-width: 220px; max-width: 300px; }
