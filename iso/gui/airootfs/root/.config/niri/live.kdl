// Live ISO only. iso/gui/customize.sh copies the installed ZeXOS niri setup
// (stow/niri) next to this file and adds an include for it, so the live
// desktop has the same look and the same keys as the installed system.
// These are the extras the live desktop needs on top.

// The installer opens by itself; Mod+I (or "Install ZeXOS" in the
// launcher, Mod+Space) opens it again after you close it.
spawn-at-startup "zexos-gui-installer"

binds {
    Mod+I hotkey-overlay-title="Install ZeXOS" { spawn "zexos-gui-installer"; }
}

// The installer is a normal tiled window, so apps you open (Dolphin, a
// terminal, Firefox) go next to it instead of hiding behind it. It can't
// get narrower than 1024 px, so other windows open at 45% of the screen,
// which still fits beside it on a 1920 px wide screen.
window-rule {
    match app-id="calamares"
    default-column-width { proportion 0.5; }
}

window-rule {
    exclude app-id="calamares"
    default-column-width { proportion 0.45; }
}
