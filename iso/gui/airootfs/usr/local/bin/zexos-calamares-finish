#!/usr/bin/env bash
# Calamares step: installs the ZeXOS desktop into the new system.
#   zexos-calamares-finish <root> <user> "<compositors>" "<shells>" "<driver sets>"
# Then the ticked boxes from the picker pages (space separated) and the
# Drivers page's chosen sets (comma separated).
set -euo pipefail
ROOT="${1:?}" USERNAME="${2:?}"

# The Wi-Fi (and other saved networks) used on the live ISO also work after
# the first boot. Calamares' own networkcfg step is not enough: it skips
# the copy when the folder is missing, and keeps per-user permissions lines.
# The live card is called wlan0 but the installed one has another name
# (wlp0s20f3), so the profile must not name an interface.
# Copy every saved connection ourselves, usable by all users. A failure here
# never stops the install.
nm_src=/etc/NetworkManager/system-connections nm_dst="$ROOT/etc/NetworkManager/system-connections"
if [ -d "$nm_src" ]; then
    mkdir -p "$nm_dst"
    for c in "$nm_src"/*.nmconnection; do
        [ -f "$c" ] || continue
        n="${c##*/}"
        [ "$n" = LTSP.nmconnection ] && continue
        ( umask 077; grep -v -e '^permissions=' -e '^interface-name=' "$c" > "$nm_dst/$n" ) &&
            chmod 600 "$nm_dst/$n" && echo "Saved network carried over: ${n%.nmconnection}" || true
        grep -q '^psk-flags=[1-9]' "$c" && echo "Note: ${n%.nmconnection} keeps its password in the login keyring, so it may ask again after boot."
    done
fi

# Keep only names we know; nothing valid left means install them all.
only_known() {
    local known="$1" out="" w
    for w in $2; do
        case " $known " in *" $w "*) out="${out:+$out }$w" ;; esac
    done
    echo "${out:-$known}"
}
ZEXOS_COMPOSITORS="$(only_known "niri hyprland mango" "${3:-}")"
ZEXOS_SHELLS="$(only_known "noctalia dms" "${4:-}")"
export ZEXOS_COMPOSITORS ZEXOS_SHELLS
echo "Compositors: $ZEXOS_COMPOSITORS / shells: $ZEXOS_SHELLS"
# The Drivers page's pick, for zexos-install-into (only known-looking set ids).
if [[ "${5:-}" =~ ^[a-z0-9,-]+$ ]]; then printf '%s' "$5" > /tmp/zexos-drivers-choice; fi
exec /usr/local/bin/zexos-install-into "$ROOT" "$USERNAME"
