# ZeXOS: upstream Calamares, with the QML package chooser (packagechooserq)
# for the animated compositor/shell previews. Plain Arch packages only.

pkgname=zexos-calamares
pkgver=3.3.14
pkgrel=2
pkgdesc='Distribution-independent installer framework'
arch=('x86_64')
license=(GPL-3.0-or-later)
url="https://github.com/calamares/calamares"
conflicts=('calamares')
provides=('calamares')
depends=(
  boost-libs
  cryptsetup
  dmidecode
  gptfdisk
  kconfig
  kcoreaddons
  kcrash
  ki18n
  kparts
  kpmcore
  kservice
  kwidgetsaddons
  libpwquality
  networkmanager
  polkit-qt6
  python
  qt6-declarative
  qt6-imageformats
  qt6-svg
  rsync
  solid
  squashfs-tools
  upower
  yaml-cpp
)
makedepends=(
  boost
  cmake
  extra-cmake-modules
  git
  ninja
  python-jsonschema
  python-pyaml
  qt6-tools
)
source=("calamares::git+${url}.git#tag=v${pkgver}")
sha256sums=('SKIP')
options=('!emptydirs')

prepare() {
    # Welcome page: upstream puts an empty stretch above the logo, so the
    # logo only gets the bottom half of the page and sits low. Give the
    # logo the stretch instead, so it is centred.
    local f=calamares/src/modules/welcome/checker/ResultsListWidget.cpp
    grep -q 'm_centralLayout->addWidget( imageLabel );' "$f"
    sed -i 's|m_centralLayout->addWidget( imageLabel );|m_centralLayout->addWidget( imageLabel, 1 );|' "$f"
}

build() {
    cmake -S calamares -B build \
        -GNinja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DWITH_QT6=ON \
        -DWITH_APPSTREAM=OFF \
        -DWITH_PYBIND11=OFF \
        -DINSTALL_CONFIG=ON \
        -DSKIP_MODULES="dracut dracutlukscfg \
        dummycpp dummyprocess dummypython dummypythonqt \
        finishedq keyboardq license localeq notesqml oemid \
        openrcdmcryptcfg fsresizer \
        rawfs mkinitfs contextualprocess interactiveterminal \
        plasmalnf services-openrc \
        summaryq tracking usersq webview welcomeq"
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    # The ISO starts Calamares itself; no menu entry.
    rm -rf "$pkgdir/usr/share/applications"
}
