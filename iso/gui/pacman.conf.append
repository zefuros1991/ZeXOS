# ZEXOS-LIVE-ONLY: the local repo with our Calamares build (zexos-calamares,
# see iso/gui/calamares-pkg), used to build the live ISO only. Listed after
# Arch's own repos, so Arch's packages always win.
[zexos-iso]
SigLevel = Optional TrustAll
Server = file://@LOCALREPO@

# Prebuilt ZeXOS packages (noctalia-zexos, bibata-cursor-zexos, qt6ct-kde,
# mpvpaper) for the live desktop, signed with the ZeXOS key (build.sh puts
# that key in the build's own keyring). The installed system adds this repo
# itself.
[zexos]
SigLevel = Required
Server = https://github.com/zefuros1991/ZeXOS/releases/download/prebuilt
