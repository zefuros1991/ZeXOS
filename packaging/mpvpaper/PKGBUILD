# mpvpaper (https://github.com/GhostNaN/mpvpaper): plays a video as the
# wallpaper. The Noctalia "Video Wallpaper" plugin runs it for the animated
# ZeXOS wallpaper. CachyOS has it in its repos; plain Arch and EndeavourOS
# only have it in the AUR, so scripts/packages.sh builds this recipe there
# instead. Source is the author's release, checked against a fixed checksum.

pkgname=mpvpaper
pkgver=1.9
pkgrel=1
pkgdesc='Video wallpaper program for wlroots based wayland compositors (ZeXOS)'
arch=('x86_64')
url="https://github.com/GhostNaN/mpvpaper"
license=('GPL-3.0-only')
depends=('mpv' 'wayland')
makedepends=('meson' 'ninja' 'wayland-protocols')
optdepends=('socat: control via sockets')
source=("$pkgname-$pkgver.tar.gz::$url/archive/$pkgver.tar.gz")
b2sums=('6b3c148d812d068878ba3acdb48b1f6d376980de3bf7bf23204c906011fd0bb8c0ebbb10fd77de1fcb8b4e3c543a6b5a8f1db92e189b128ec44fdfefbfc4b9bf')

build() {
    arch-meson "$pkgname-$pkgver" build
    meson compile -C build
}

package() {
    meson install -C build --destdir "$pkgdir"
    install -Dm644 "$pkgname-$pkgver/mpvpaper.man" "$pkgdir/usr/share/man/man1/$pkgname.1"
}
