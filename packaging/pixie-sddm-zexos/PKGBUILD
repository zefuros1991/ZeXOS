# Pixie login screen theme for SDDM (https://github.com/xCaptaiN09/pixie-sddm).
# Downloads a tagged release straight from the author's GitHub, checked
# against a fixed checksum, so nothing comes from the AUR.
# Built by scripts/packages.sh with `makepkg -si`.

pkgname=pixie-sddm-zexos
pkgver=3.0
pkgrel=3
pkgdesc='Pixie SDDM theme, from the official release (ZeXOS)'
arch=('any')
url="https://github.com/xCaptaiN09/pixie-sddm"
license=('MIT')
# Version 3 is a Qt 6 theme.
depends=('sddm' 'qt6-declarative' 'qt6-svg')
provides=('pixie-sddm')
conflicts=('pixie-sddm' 'pixie-sddm-git')
# avatar-*.jpg: the ZeXOS logo for the round picture above the login box,
# one for each wallpaper colour set, drawn by make-avatar.py.
install=pixie-sddm-zexos.install
source=("pixie-sddm-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
        avatar-{violet,ocean,ember,forest,mono,light}.jpg)
sha256sums=('bde5ddfac7c50f188bb1879a00914614c9091a043f14d4b3cba4156208b4efb0'
            'bc80caecbc701af6c3a80890f3a3a96bddbb06164eb2751850585f899adbf827'
            'f3130978f53722413b1b776107d780996fa0628c8a3785ce75d5ab6a90ab22fe'
            '3f34151a4853c69ac1b56afe2f893e59bd382ee65ee0ea59dd093b201f87b531'
            'f5385dc05e27612d8b41705a4fcd8df818286dd6f82d11aee2f1e9ae1d6b12ab'
            'f9869fe438fba49104a6c01f6c189e95cf2a4827e13c9e25fed3bae91b0d58ce'
            'af638894457e86954e39bcbc7ea24be50a02074489f3f471d8d91c5702666b7c')

package() {
    cd "$srcdir/pixie-sddm-$pkgver"
    install -d "$pkgdir/usr/share/sddm/themes/pixie"
    cp -r assets components Main.qml metadata.desktop theme.conf LICENSE \
        "$pkgdir/usr/share/sddm/themes/pixie/"
    # Pixie always shows assets/avatar.jpg (see make-avatar.py for why).
    # It becomes a link to a file you can write, next to the login wallpaper,
    # so sync-sddm-wallpaper.sh can put the avatar in your wallpaper's colours
    # there. The .install file puts the violet one there to start with.
    local name
    for name in violet ocean ember forest mono light; do
        install -Dm644 "$srcdir/avatar-$name.jpg" \
            "$pkgdir/usr/share/sddm/themes/pixie/assets/avatars/$name.jpg"
    done
    ln -sf /var/lib/sddm-wallpaper/avatar.jpg \
        "$pkgdir/usr/share/sddm/themes/pixie/assets/avatar.jpg"
}
