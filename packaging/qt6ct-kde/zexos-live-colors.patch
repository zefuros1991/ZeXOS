diff --git a/src/qt6ct-qtplugin/qt6ctplatformtheme.cpp b/src/qt6ct-qtplugin/qt6ctplatformtheme.cpp
index 78c2eae..d500d83 100644
--- a/src/qt6ct-qtplugin/qt6ctplatformtheme.cpp
+++ b/src/qt6ct-qtplugin/qt6ctplatformtheme.cpp
@@ -290,7 +290,25 @@ void Qt6CTPlatformTheme::createFSWatcher()
     timer->setSingleShot(true);
     timer->setInterval(3000);
     connect(watcher, &QFileSystemWatcher::directoryChanged, timer, qOverload<>(&QTimer::start));
+    //ZeXOS: also reload when the colour scheme file changes, so apps follow
+    //a new wallpaper without being restarted
+    connect(watcher, &QFileSystemWatcher::fileChanged, timer, qOverload<>(&QTimer::start));
     connect(timer, &QTimer::timeout, this, &Qt6CTPlatformTheme::updateSettings);
+    m_watcher = watcher;
+    watchColorScheme();
+}
+
+void Qt6CTPlatformTheme::watchColorScheme()
+{
+    //the file is often replaced rather than edited, which ends the watch,
+    //so watch its folder too and add the file back each time
+    if(!m_watcher || m_schemePath.isEmpty())
+        return;
+    const QString dir = QFileInfo(m_schemePath).absolutePath();
+    if(!m_watcher->directories().contains(dir))
+        m_watcher->addPath(dir);
+    if(!m_watcher->files().contains(m_schemePath) && QFile::exists(m_schemePath))
+        m_watcher->addPath(m_schemePath);
 }
 
 void Qt6CTPlatformTheme::updateSettings()
@@ -298,6 +316,7 @@ void Qt6CTPlatformTheme::updateSettings()
     qCDebug(lqt6ct) << "updating settings..";
     readSettings();
     applySettings();
+    watchColorScheme();
 }
 
