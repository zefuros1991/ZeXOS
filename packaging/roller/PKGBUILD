# ZeXOS roller: the coverflow wallpaper picker bound to Mod+W.
# Upstream (github.com/zyrophix/roller) was deleted, so we keep our own copy:
# roller-binary.tar.zst is the package we built from commit 184debe plus our
# three patches (wheel/size, video groups, touchpad swipe). This recipe only
# repacks it, so the result is the same program. The recipe that built it from
# source is kept as PKGBUILD.from-source (with the patches), for reference; it
# can't run any more because the upstream code is gone.

pkgname=roller
pkgver=0.1.0.r4.g184debe
pkgrel=5
pkgdesc='Coverflow wallpaper picker for wlr-layer-shell desktops (ZeXOS patched, kept copy)'
arch=('x86_64')
url="https://github.com/zyrophix/roller"
license=('MIT')
source=('roller-binary.tar.zst')
noextract=('roller-binary.tar.zst')
sha256sums=('SKIP')
depends=('qt6-base' 'qt6-declarative' 'layer-shell-qt')

package() {
    bsdtar -xf "$srcdir/roller-binary.tar.zst" -C "$pkgdir" usr
}
