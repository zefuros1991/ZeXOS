# Zen browser for distros without it in their repos (plain Arch,
# EndeavourOS, ...). CachyOS has zen-browser-bin in its repo and uses that.
# Repacks Zen's official release; the helper files (launcher, desktop
# entry, update policy) are the AUR zen-browser-bin ones, unchanged.
# Based on the AUR zen-browser-bin PKGBUILD by Luis Vervaet, Peter Jung
# and contributors.
#
# pacman won't update this by itself. Running install.sh again updates it
# once this recipe has been moved to a newer version.
pkgname=zen-browser-zexos
_pkgname=zen-browser
pkgver=1.22.3b
pkgrel=1
pkgdesc="Zen, a Firefox-based web browser, from the official release (ZeXOS)"
arch=('x86_64')
url="https://github.com/zen-browser/desktop"
license=('MPL-2.0')
depends=(gtk3 libxt mime-types dbus-glib nss ttf-font systemd ffmpeg)
optdepends=('libnotify: Notification integration'
            'hunspell-en_US: Spell checking, American English')
options=('!strip')
provides=("zen-browser=$pkgver" 'zen-browser-bin')
conflicts=('zen-browser' 'zen-browser-bin')
source=("zen-browser-$pkgver-x86_64.tar.xz::$url/releases/download/$pkgver/zen.linux-x86_64.tar.xz"
        "$_pkgname.sh"
        "zen.desktop"
        "policies.json")
sha256sums=('0aaee1b3f67f074aebf7fc6c2fe824441bcafd431e9991336479c16370519dd0'
            '642bcde5b15fddb712d10ed53299781108a265432237ab27a96c5c5c489718db'
            'bfb347f0e0f6baccaf3b7b51b19a25e5b745d836734cec38611b32af842897f6'
            'fd9572d178ea1a5edf427ca85bad3fb2d83be2e250e62bad13951d70d977bd0f')

package() {
    # Same folder as zen-browser-bin, so the launcher and desktop entry match.
    local dest=/opt/zen-browser-bin
    install -d "$pkgdir/usr/bin" "$pkgdir/usr/share/applications" "$pkgdir/opt"
    cp -r zen/ "$pkgdir$dest"

    install -m755 "$_pkgname.sh" "$pkgdir/usr/bin/$_pkgname"
    install -m644 zen.desktop "$pkgdir/usr/share/applications/"

    for i in 16x16 32x32 48x48 64x64 128x128; do
        install -d "$pkgdir/usr/share/icons/hicolor/$i/apps/"
        ln -s "$dest/browser/chrome/icons/default/default${i/x*}.png" \
              "$pkgdir/usr/share/icons/hicolor/$i/apps/$_pkgname.png"
    done

    # Use the system's dictionaries and certificates.
    ln -Ts /usr/share/hunspell "$pkgdir$dest/dictionaries"
    ln -Ts /usr/share/hyphen "$pkgdir$dest/hyphenation"
    ln -sf /usr/lib/libnssckbi.so "$pkgdir$dest/libnssckbi.so"

    # Updates come through this package, not Zen's own updater.
    install -Dm644 policies.json "$pkgdir$dest/distribution/policies.json"
}
