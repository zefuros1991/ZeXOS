<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>ZeXOS</vendor>
  <vendor_url>https://github.com/zefuros1991/ZeXOS</vendor_url>
  <action id="org.zexos.drivers.change">
    <description>Change the graphics, Wi-Fi or network drivers</description>
    <message>ZeXOS - Welcome wants to change drivers. Type your password to allow it.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/zexos-drivers-helper</annotate>
  </action>
</policyconfig>
