#!/bin/sh
# Tap Super twice quickly to open or close the overview, on niri, Mango and Hyprland.
# Each Super tap runs this script; it only acts on the second tap.
window=${SUPER_TAP_MS:-300}   # how quick the second tap must be, in ms
stamp="${XDG_RUNTIME_DIR:-/tmp}/super-double-tap"

now=$(date +%s%3N)
last=$(cat "$stamp" 2>/dev/null || echo 0)

if [ $((now - last)) -le "$window" ]; then
	rm -f "$stamp"
	if [ -n "$NIRI_SOCKET" ]; then
		niri msg action toggle-overview
	else
		mango-overview toggle
	fi
else
	echo "$now" > "$stamp"
fi
