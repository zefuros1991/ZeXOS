#!/usr/bin/env python3
"""Copy a KDE colour scheme into kdeglobals and tell open KDE apps.

KDE apps such as Dolphin take their colours from ~/.config/kdeglobals, not
from the .colors file qt6ct points at. Noctalia copies its colours in there by
itself on every wallpaper change. DankMaterialShell only does that on a full
Plasma install, so zshell and zexos-dms-sync run this for it:

    zexos-kde-colors ~/.local/share/color-schemes/DankMatugen.colors

Every group of the scheme ([Colors:View], [Colors:Window], ...) replaces the
same keys in kdeglobals; everything else in kdeglobals is kept, in order.
The scheme's own name ([General] ColorScheme) is left alone: DMS would take a
"DankMatugen" name there as a sign to run Plasma's own colour tool.
This does the same as Noctalia's src/theme/kde_color_scheme.cpp.
"""
import os
import subprocess
import sys
import tempfile

SKIP = {("General", "ColorScheme"), ("General", "Name")}


def parse(path):
    """Groups in file order: [(name or None, [lines])]."""
    groups = [(None, [])]
    with open(path, encoding="utf-8") as f:
        for line in f.read().splitlines():
            s = line.strip()
            if s.startswith("[") and s.endswith("]"):
                groups.append((s[1:-1], []))
            else:
                groups[-1][1].append(line)
    return groups


def key_of(line):
    s = line.strip()
    if not s or s.startswith("#") or s.startswith(";") or "=" not in s:
        return None
    return s.split("=", 1)[0].strip()


def merge(dest_groups, src_groups):
    index = {name: i for i, (name, _) in enumerate(dest_groups)}
    for name, lines in src_groups:
        if name is None:
            continue
        pairs = [(key_of(l), l.strip()) for l in lines]
        pairs = [(k, l) for k, l in pairs if k and (name, k) not in SKIP]
        if not pairs:
            continue
        if name not in index:
            index[name] = len(dest_groups)
            dest_groups.append((name, []))
        dest = dest_groups[index[name]][1]
        where = {key_of(l): i for i, l in enumerate(dest) if key_of(l)}
        for k, l in pairs:
            if k in where:
                dest[where[k]] = l
            else:
                # New keys go before the blank lines at the end of the group.
                at = len(dest)
                while at > 0 and not dest[at - 1].strip():
                    at -= 1
                dest.insert(at, l)
                where = {key_of(x): i for i, x in enumerate(dest) if key_of(x)}


def render(groups):
    out = []
    for name, lines in groups:
        if name is not None:
            if out and out[-1].strip():
                out.append("")
            out.append(f"[{name}]")
        out.extend(lines)
    return "\n".join(out).rstrip("\n") + "\n"


def main():
    if len(sys.argv) != 2 or not os.path.isfile(sys.argv[1]):
        sys.exit("usage: zexos-kde-colors <scheme.colors>")
    conf = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    # Write to the real file, so a kdeglobals that is a link stays a link.
    target = os.path.realpath(os.path.join(conf, "kdeglobals"))
    groups = parse(target) if os.path.exists(target) else [(None, [])]
    merge(groups, parse(sys.argv[1]))
    text = render(groups)
    old = open(target, encoding="utf-8").read() if os.path.exists(target) else None
    if text != old:
        fd, tmp = tempfile.mkstemp(dir=os.path.dirname(target), prefix=".kdeglobals.")
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
        os.chmod(tmp, 0o644)
        os.replace(tmp, target)
    # The signal KDE apps listen for to repaint with the new colours
    # (KGlobalSettings::notifyChange, 0 = palette changed).
    subprocess.run(["dbus-send", "--session", "--type=signal", "/KGlobalSettings",
                    "org.kde.KGlobalSettings.notifyChange", "int32:0", "int32:0"],
                   check=False, stderr=subprocess.DEVNULL)


if __name__ == "__main__":
    main()
