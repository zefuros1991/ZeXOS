#!/usr/bin/env bash
# Take a screenshot on Mango or Hyprland, the way niri does it by itself:
# save it to ~/Pictures/Screenshots and copy it to the clipboard.
#
#   zexos-screenshot area     drag to pick an area
#   zexos-screenshot screen   the screen the pointer is on
#   zexos-screenshot window   just the focused window
#
# Needs grim (takes the picture), slurp (lets you pick an area) and
# wl-copy (clipboard). Mango's keybinds.conf and Hyprland's keybinds.lua
# call this.
set -euo pipefail

dir="${XDG_PICTURES_DIR:-$HOME/Pictures}/Screenshots"
file="$dir/Screenshot from $(date '+%Y-%m-%d %H-%M-%S').png"
mkdir -p "$dir"   # grim won't make the folder itself

# Print the named fields of the JSON object on stdin, one per line.
json_get() {
    python3 -c 'import json, sys
d = json.load(sys.stdin)
d = d[0] if isinstance(d, list) and d else d
for k in sys.argv[1:]:
    if k in d: print(d[k])' "$@"
}

case "${1:-}" in
    area)
        # Esc or a click outside cancels; that's not an error.
        geom=$(slurp) || exit 0
        grim -g "$geom" "$file"
        ;;
    screen)
        # The screen the pointer is on (Mango) or the focused screen
        # (Hyprland).
        if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
            mon=$(hyprctl -j monitors 2>/dev/null | python3 -c 'import json, sys
print(next((m["name"] for m in json.load(sys.stdin) if m.get("focused")), ""))' || true)
        else
            mon=$(mmsg get cursorpos 2>/dev/null | json_get monitor || true)
        fi
        if [ -n "$mon" ]; then grim -o "$mon" "$file"; else grim "$file"; fi
        ;;
    window)
        # The compositor tells where the focused window is and how big it is.
        if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
            info=$(hyprctl -j activewindow 2>/dev/null || true)
            geom=$(python3 -c 'import json, sys
try:
    d = json.load(sys.stdin)
    print("%d,%d %dx%d" % (*d["at"], *d["size"]))
except Exception:
    pass' <<<"$info" || true)
        else
            info=$(mmsg get focusing-client 2>/dev/null || true)
            geom=$(json_get x y width height <<<"$info" | tr '\n' ' ' \
                | awk 'NF==4 {printf "%d,%d %dx%d", $1, $2, $3, $4}' || true)
        fi
        if [ -z "$geom" ]; then
            notify-send "Screenshot" "No window is focused." 2>/dev/null || true
            exit 1
        fi
        grim -g "$geom" "$file"
        ;;
    *)
        echo "usage: zexos-screenshot area|screen|window" >&2
        exit 2
        ;;
esac

wl-copy --type image/png < "$file"
notify-send -i "$file" "Screenshot saved" "${file/#$HOME/\~}" 2>/dev/null || true
