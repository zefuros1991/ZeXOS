#!/usr/bin/env bash
# zshell -- one front door for the desktop shell (the top bar, launcher,
# notifications, lock screen). ZeXOS ships two: Noctalia and
# DankMaterialShell (DMS). Your keyboard shortcuts call zshell, and zshell
# passes each action on to whichever shell you picked, so the same keys
# work in both.
#
#   zshell start            start the shell you picked (the compositor runs this at login)
#   zshell switch <name>    change shell now and remember it (noctalia | dms)
#   zshell menu             pick a shell from a small menu (Mod+Shift+D)
#   zshell current          print the shell you picked
#   zshell relink           point app colours (kitty, Qt, GTK, KDE apps, launcher,
#                           btop) at the shell in use; the DMS watcher runs it
#   zshell <action>         launcher, session, lock, cheatsheet, wallpaper-random,
#                           wallpaper-set <file>, volume-up, volume-down,
#                           volume-mute, mic-mute, media-toggle, media-next,
#                           media-prev, brightness-up, brightness-down
#
# Your choice is saved in ~/.config/zexos/shell, so it stays after a
# restart. Each user has their own.
#
# Commands used:
#   Noctalia: `noctalia msg --help`
#   DMS:      `dms ipc call ...`, see /usr/share/doc/dms-shell/IPC.md or
#             https://danklinux.com/docs/dankmaterialshell/keybinds-ipc

set -u

CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}"
CHOICE_FILE="$CONF_DIR/zexos/shell"
NIRI_DIR="$CONF_DIR/niri"
MANGO_DIR="$CONF_DIR/mango"
HYPR_DIR="$CONF_DIR/hypr"
DMS_DIR="$CONF_DIR/DankMaterialShell"
DMS_SEED="${XDG_DATA_HOME:-$HOME/.local/share}/zexos/dms"
WALL_DIR="$HOME/Pictures/Wallpapers"
SHELLS="noctalia dms"

installed() {
    case "$1" in
        noctalia) command -v noctalia >/dev/null 2>&1 ;;
        dms)      command -v dms >/dev/null 2>&1 ;;
        *)        return 1 ;;
    esac
}

pretty() {
    case "$1" in
        noctalia) echo "Noctalia" ;;
        dms)      echo "DankMaterialShell" ;;
    esac
}

# The saved choice, or Noctalia when nothing was saved yet. If the saved
# shell was uninstalled, fall back to one that is there.
current() {
    local shell=""
    [ -r "$CHOICE_FILE" ] && shell="$(head -n1 "$CHOICE_FILE")"
    case " $SHELLS " in *" $shell "*) ;; *) shell=noctalia ;; esac
    if ! installed "$shell"; then
        for s in $SHELLS; do installed "$s" && { shell="$s"; break; }; done
    fi
    echo "$shell"
}

# Window colours (niri, Mango and Hyprland) come from the running shell.
# config.kdl always loads noctalia.kdl and then shell-colors.kdl; for DMS
# this file points at the colours DMS writes, so they win. niri reloads it
# on its own. Mango's config.conf and Hyprland's hyprland.lua do the same
# (noctalia.conf / noctalia.lua, then shell-colors), but need to be told
# to reload.
link_colors() {
    local file="$NIRI_DIR/shell-colors.kdl"
    if [ -d "$NIRI_DIR" ]; then
        if [ "$1" = dms ]; then
            printf '%s\n' '// Written by zshell: DankMaterialShell is the active shell,' \
                '// plus the gradient border it writes from our template.' \
                'include optional=true "./dms/colors.kdl"' \
                'include optional=true "./zexos-border-dms.kdl"' > "$file"
        else
            printf '%s\n' '// Written by zshell: Noctalia is the active shell,' \
                '// its colours come from noctalia.kdl, plus the gradient' \
                '// border Noctalia writes from our template.' \
                'include optional=true "./zexos-border.kdl"' > "$file"
        fi
    fi
    file="$MANGO_DIR/shell-colors.conf"
    if [ -d "$MANGO_DIR" ]; then
        if [ "$1" = dms ]; then
            printf '%s\n' '# Written by zshell: DankMaterialShell is the active shell.' \
                'source-optional=./dms/colors.conf' > "$file"
        else
            printf '%s\n' '# Written by zshell: Noctalia is the active shell,' \
                '# its colours come from noctalia.conf.' > "$file"
        fi
        [ -n "${MANGO_INSTANCE_SIGNATURE:-}" ] && mmsg dispatch reload_config >/dev/null 2>&1
    fi
    file="$HYPR_DIR/shell-colors.lua"
    if [ -d "$HYPR_DIR" ]; then
        if [ "$1" = dms ]; then
            printf '%s\n' '-- Written by zshell: DankMaterialShell is the active shell,' \
                '-- plus the gradient border it writes from our template.' \
                'pcall(require, "dms.colors")' \
                'pcall(require, "zexos-border-dms")' > "$file"
        else
            printf '%s\n' '-- Written by zshell: Noctalia is the active shell,' \
                '-- its colours come from noctalia.lua, plus the gradient' \
                '-- border Noctalia writes from our template.' \
                'pcall(require, "zexos-border")' > "$file"
        fi
        if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
            hyprctl reload >/dev/null 2>&1
            # Hyprland only notices changes to files it already loaded. The
            # first time Noctalia runs, noctalia.lua doesn't exist yet, so
            # wait (up to 30 s) for Noctalia to write it, then reload once.
            if [ "$1" != dms ]; then
                (
                    for _ in $(seq 30); do
                        [ "$HYPR_DIR/noctalia.lua" -nt "$file" ] && break
                        sleep 1
                    done
                    sleep 1
                    hyprctl reload
                ) >/dev/null 2>&1 &
            fi
        fi
    fi
    return 0
}

# Kitty follows the same idea: kitty.conf loads themes/shell.conf last.
# An include inside themes/shell.conf is read from themes/, so it gets the
# full path to DMS's dank-theme.conf (which sits next to kitty.conf).
link_kitty() {
    local dir="$CONF_DIR/kitty"
    [ -d "$dir/themes" ] || return 0
    if [ "$1" = dms ]; then
        echo "include $dir/dank-theme.conf" > "$dir/themes/shell.conf"
    else
        echo '# Written by zshell: Noctalia is the active shell (themes/noctalia.conf).' > "$dir/themes/shell.conf"
    fi
    # Running kitty windows pick the new colours up right away.
    pkill -USR1 -x kitty 2>/dev/null || true
}

# Noctalia reads every .toml file in ~/.config/noctalia and merges them, so
# settings that depend on the compositor go in their own small file.
# On Mango:
#  - Mango always has 9 tags; without this the bar shows all 9 pills. niri
#    and Hyprland add workspaces as you need them, so they keep the default.
#  - Pop-ups take their background from the bar, which is fully clear.
#    Mango only blurs where something is drawn, so a clear pop-up gets no
#    blur at all. A 2% background is invisible but gives Mango something
#    to blur (see blur_layer in Mango's rules.conf).
link_noctalia() {
    local dir="$CONF_DIR/noctalia"
    [ -d "$dir" ] || return 0
    if [ "$(compositor)" = mangowc ]; then
        printf '%s\n' '# Written by zshell: Mango is running.' \
            '' \
            '# Only show tags that have windows, plus the one you are on.' \
            '[widget.workspaces]' 'hide_when_empty = true' \
            '' \
            '# Just enough background for Mango to blur the pop-ups.' \
            '[bar.default]' 'background_opacity = 0.02' > "$dir/zexos-compositor.toml"
    else
        echo '# Written by zshell: nothing extra for this compositor.' > "$dir/zexos-compositor.toml"
    fi
}

# First DMS start: give it the ZeXOS look (a copy, so DMS can save your own
# changes over it). Never touches settings you already have.
seed_dms() {
    [ -d "$DMS_SEED" ] || return 0
    mkdir -p "$DMS_DIR" "${XDG_STATE_HOME:-$HOME/.local/state}/DankMaterialShell"
    if [ ! -e "$DMS_DIR/settings.json" ]; then
        cp "$DMS_SEED/settings.json" "$DMS_DIR/settings.json"
        # DMS sees a settings file and takes you for an old user, so it opens
        # its "What's new in 1.x" window. Mark this version as seen; a later
        # DMS update still shows its own news.
        local ver
        ver="$(dms version 2>/dev/null | sed -n 's/^dms v\([0-9]*\.[0-9]*\).*/\1/p')"
        [ -n "$ver" ] && touch "$DMS_DIR/.changelog-$ver"
    fi
    # Settings from before the middle island opened on click only: switch
    # it to click once. If you change it back in DMS, that is kept.
    local memo="${XDG_STATE_HOME:-$HOME/.local/state}/zexos/dms-island-click"
    if [ ! -e "$memo" ] && [ -e "$DMS_DIR/settings.json" ]; then
        python3 - "$DMS_DIR/settings.json" <<'EOF' && mkdir -p "${memo%/*}" && touch "$memo"
import json, sys
path = sys.argv[1]
with open(path) as f:
    data = json.load(f)
bars = data.get("barConfigs") or []
if any("islandInteractionMode" not in bar for bar in bars):
    for bar in bars:
        bar.setdefault("islandInteractionMode", "click")
    with open(path, "w") as f:
        json.dump(data, f, indent=2)
EOF
    fi
    local session="${XDG_STATE_HOME:-$HOME/.local/state}/DankMaterialShell/session.json"
    if [ ! -e "$session" ]; then
        sed "s|@HOME@|$HOME|g" "$DMS_SEED/session.json" > "$session"
    fi
}

# Everything else that takes the wallpaper colours: Qt and KDE apps
# (Dolphin), GTK apps, the fuzzel menus and btop. Each has one "shell" file
# or link that points at Noctalia's colours or at DMS's. Safe to run often;
# the DMS watcher (zexos-dms-sync) runs it after every DMS colour change.
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}"
link_theme() {
    local shell="$1" schemes="$DATA_DIR/color-schemes" scheme css
    if [ "$shell" = dms ]; then scheme=DankMatugen.colors; else scheme=noctalia.colors; fi

    # Qt apps read ZeXOS.colors (qt6ct.conf); KDE apps read kdeglobals.
    if [ -e "$schemes/$scheme" ]; then
        ln -sfn "$scheme" "$schemes/ZeXOS.colors"
        "$HOME/.local/bin/zexos-kde-colors" "$schemes/$scheme" 2>/dev/null || true
        # Open Qt apps only reload when told to (see zexos-qt-refresh).
        "$HOME/.local/bin/zexos-qt-refresh" 2>/dev/null || true
    fi

    # GTK: gtk.css imports shell.css last, which loads DMS's colours or
    # nothing (Noctalia's come from noctalia.css). Older gtk.css files get
    # the import line added once.
    for css in "$CONF_DIR/gtk-3.0" "$CONF_DIR/gtk-4.0"; do
        [ -d "$css" ] || continue
        if [ "$shell" = dms ]; then
            echo '@import url("dank-colors.css");' > "$css/shell.css"
        else
            echo '/* Written by zshell: Noctalia is the active shell (noctalia.css). */' > "$css/shell.css"
        fi
        if [ -f "$css/gtk.css" ] && ! grep -q 'shell.css' "$css/gtk.css"; then
            printf '\n/* Written by zshell: the running shell'"'"'s colours. */\n@import url("shell.css");\n' >> "$css/gtk.css"
        fi
    done

    # fuzzel (menus like this one): fuzzel.ini includes themes/shell.
    local fz="$CONF_DIR/fuzzel/themes"
    if [ -d "$fz" ]; then
        if [ "$shell" = dms ] && [ -e "$fz/dank" ]; then
            ln -sfn dank "$fz/shell"
        else
            ln -sfn noctalia "$fz/shell"
        fi
        # Noctalia's fuzzel hook changes fuzzel.ini to include its own
        # colours (themes/noctalia) for good, which left the menus green
        # under DMS. Put themes/shell back. Writing with > (not sed -i)
        # goes through the stow link instead of replacing it.
        local ini="$CONF_DIR/fuzzel/fuzzel.ini" want='include=~/.config/fuzzel/themes/shell'
        if [ -f "$ini" ] && ! grep -qxF "$want" "$ini"; then
            local fixed
            fixed="$(sed "s|^include=.*themes.*|$want|" "$ini")"
            printf '%s\n' "$fixed" > "$ini"
        fi
    fi

    # btop: pick the theme file by name, then tell running btop to reload.
    local bt="$CONF_DIR/btop/btop.conf" name=noctalia
    [ "$shell" = dms ] && [ -e "$CONF_DIR/btop/themes/dank.theme" ] && name=dank
    if [ -f "$bt" ] && ! grep -q "^color_theme = \"$name\"" "$bt"; then
        sed -i "s|^color_theme = .*|color_theme = \"$name\"|" "$(realpath "$bt")"
        pkill -USR2 -x btop 2>/dev/null || true
    fi
}

# DMS extras: the ZeXOS colour templates (fuzzel, btop) and the shell
# switcher button on the bar. Re-copied on every start so updates arrive.
setup_dms() {
    [ -d "$DMS_SEED" ] || return 0
    local mdir="$CONF_DIR/matugen/dms/configs"
    if [ -f "$DMS_SEED/matugen/zexos.toml.in" ]; then
        mkdir -p "$mdir"
        sed -e "s|@SEED@|$DMS_SEED|g" -e "s|@CONFIG@|$CONF_DIR|g" \
            "$DMS_SEED/matugen/zexos.toml.in" > "$mdir/zexos.toml.tmp" &&
            mv "$mdir/zexos.toml.tmp" "$mdir/zexos.toml"
    fi
    if [ -d "$DMS_SEED/plugins" ]; then
        mkdir -p "$DMS_DIR/plugins"
        cp -rT "$DMS_SEED/plugins/ZexosShellSwitch" "$DMS_DIR/plugins/ZexosShellSwitch"
        # Turn the plugin on once; if you turn it off later, it stays off.
        python3 - "$DMS_DIR/plugin_settings.json" <<'EOF'
import json, os, sys
p = sys.argv[1]
try:
    d = json.load(open(p))
except Exception:
    d = {}
if "zexosShellSwitch" not in d:
    d["zexosShellSwitch"] = {"enabled": True}
    json.dump(d, open(p, "w"), indent=2)
EOF
    fi
}

start() {
    local shell
    shell="$(current)"
    link_colors "$shell"
    link_kitty "$shell"
    link_theme "$shell"
    # Your animation picks, if you changed any (zexos-motion).
    [ -e "$CONF_DIR/zexos/motion" ] && zexos-motion apply >/dev/null 2>&1
    # A compositor's variable can be left behind empty from an earlier
    # session (log out of Mango, log in to niri). The shell only checks that
    # it exists, so it would think it runs in Mango and show Mango's
    # shortcuts. Drop the empty ones.
    local v
    for v in NIRI_SOCKET MANGO_INSTANCE_SIGNATURE HYPRLAND_INSTANCE_SIGNATURE; do
        [ -z "$(printenv "$v")" ] && unset "$v"
    done
    case "$shell" in
        noctalia) link_noctalia; exec noctalia ;;
        dms)      seed_dms; setup_dms; exec dms run ;;
    esac
    echo "zshell: no desktop shell installed" >&2
    exit 1
}

running() {
    case "$1" in
        noctalia) pgrep -x noctalia >/dev/null ;;
        dms)      pgrep -x dms >/dev/null ;;
    esac
}

stop() {
    case "$1" in
        noctalia) pkill -x noctalia ;;
        dms)      dms kill >/dev/null 2>&1 || pkill -x dms ;;
    esac
    for _ in $(seq 30); do running "$1" || return 0; sleep 0.1; done
    # Noctalia v5 sometimes freezes halfway through quitting: its bar goes
    # but its wallpaper stays, covering the other shell's, and the frozen
    # process makes zshell think it is still running. Upstream bug:
    # https://github.com/noctalia-dev/noctalia/issues/4652
    # So if it hasn't quit after 3 seconds, force it.
    case "$1" in
        noctalia) pkill -KILL -x noctalia ;;
        dms)      pkill -KILL -x dms; pkill -KILL -f 'qs -p .*/danklinux-shell/' ;;
    esac
    for _ in $(seq 20); do running "$1" || return 0; sleep 0.1; done
    return 1
}

switch() {
    local new="${1:-}"
    case " $SHELLS " in *" $new "*) ;; *) echo "zshell: pick one of: $SHELLS" >&2; exit 2 ;; esac
    installed "$new" || { echo "zshell: $(pretty "$new") is not installed" >&2; exit 1; }
    running "$new" || curtain_down "$new"
    mkdir -p "$(dirname "$CHOICE_FILE")"
    echo "$new" > "$CHOICE_FILE"
    for s in $SHELLS; do
        [ "$s" = "$new" ] || stop "$s"
    done
    running "$new" && return 0
    curtain_up "$new"
    # Let the compositor start it, the same way it does at login.
    if [ -n "${NIRI_SOCKET:-}" ]; then
        niri msg action spawn -- zshell start
    elif [ -n "${MANGO_INSTANCE_SIGNATURE:-}" ]; then
        mmsg dispatch "spawn,zshell start"
    elif [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
        hyprctl dispatch 'hl.dsp.exec_cmd("zshell start")' >/dev/null
    else
        setsid -f zshell start >/dev/null 2>&1
    fi
}

# The picture the running shell shows now. Asked before it quits, so the
# curtain can keep it on screen while the shells swap. A video wallpaper
# gives its first frame. Falls back to the login screen's copy.
current_wallpaper() {
    local w=""
    if running noctalia; then
        w="$(noctalia msg wallpaper-get 2>/dev/null | sed -n 's/^[^/]*\(\/.*\)$/\1/p' | head -n1)"
    elif running dms; then
        w="$(dms ipc call wallpaper get 2>/dev/null | head -n1)"
    fi
    if [ -n "$w" ] && is_video "$w"; then w="$(poster "$w")"; fi
    [ -f "$w" ] || w=/var/lib/sddm-wallpaper/current.jpg
    [ -r "$w" ] && printf '%s\n' "$w"
}

# The wallpaper a shell will show when it starts, read from what it saved
# last time (Noctalia: its video plugin or settings.toml, DMS: session.json).
# A video gives its first frame. Empty if unknown.
saved_wallpaper() {
    local w=""
    case "$1" in
        noctalia)
            # A video from the mpvpaper plugin wins over the picture.
            w="$(sed -n 's/.*"assignments":{"[^"]*":"\([^"]*\)".*/\1/p' \
                "${XDG_STATE_HOME:-$HOME/.local/state}/noctalia/mpvpaper/assignments.json" 2>/dev/null)"
            [ -n "$w" ] || w="$(sed -n '/^\[wallpaper\.\(monitors\..*\|last\)\]/,/^path/ s/^path = "\(.*\)"$/\1/p' \
                "${XDG_STATE_HOME:-$HOME/.local/state}/noctalia/settings.toml" 2>/dev/null | head -n1)" ;;
        dms)
            w="$(sed -n 's/.*"wallpaperPath": *"\([^"]*\)".*/\1/p' \
                "${XDG_STATE_HOME:-$HOME/.local/state}/DankMaterialShell/session.json" 2>/dev/null | head -n1)" ;;
    esac
    if [ -n "$w" ] && is_video "$w"; then w="$(poster "$w")"; fi
    [ -f "$w" ] && printf '%s\n' "$w"
}

# The curtain over a shell switch (~/.config/quickshell/zexos-curtain), in
# the style picked with `zexos-motion set switch ...`: logo (default), dip or
# none. It fades the screen to a dark shade of the old wallpaper's colour
# with the new shell's logo, turns that into the new wallpaper's shade while
# the shells swap, then fades out to the new shell.
curtain_down() {
    command -v qs >/dev/null 2>&1 || return 0
    local style
    style="$(zexos-motion get switch 2>/dev/null)"
    [ -n "$style" ] || style=logo
    qs kill -c zexos-curtain >/dev/null 2>&1
    # The control sockets of Noctalia's video wallpaper players, so the
    # curtain can pause them once they're hidden.
    local videos="" sock
    for sock in "${XDG_STATE_HOME:-$HOME/.local/state}"/noctalia/mpvpaper/ipc-*.sock; do
        [ -S "$sock" ] && videos="$videos$sock:"
    done
    ZX_STYLE="$style" \
    ZX_VIDEOS="$videos" \
    ZX_OLD_WALL="$(current_wallpaper)" \
    ZX_WALL="$(saved_wallpaper "$1" || current_wallpaper)" \
    ZX_BG="$(fuzzel_colour background)" \
    ZX_ICON="$(logo "$1")" \
    QT_QPA_PLATFORM=wayland \
        setsid -f qs -c zexos-curtain >/dev/null 2>&1
    # (Always Wayland: with WAYLAND_DISPLAY unset, Qt would try X11 and the
    # curtain would quit at once.)
    # Don't stop the old shell until the curtain covers it and its colour
    # slide is over (about 3 s; give up after 5 s). If it
    # never answers at all (it failed to start), don't hold the switch up.
    # Asked only 5 times a second: each question starts a `qs`, and asking
    # more often took enough of the machine to make the slide jerky.
    local state silent=0
    for _ in $(seq 25); do
        state="$(qs ipc -c zexos-curtain call curtain state 2>/dev/null)"
        [ "$state" = covered ] && break
        if [ -z "$state" ]; then
            silent=$((silent + 1)); [ "$silent" -ge 5 ] && break
        fi
        sleep 0.2
    done
}

# Lift it once the new shell has had a moment to draw its bar and wallpaper.
# The curtain itself waits until its colour change is done.
curtain_up() {
    (
        for _ in $(seq 100); do running "$1" && break; sleep 0.1; done
        sleep 1.2
        qs ipc -c zexos-curtain call curtain lift
    ) >/dev/null 2>&1 &
}

# Each shell's official logo, as an icon name (hicolor theme).
logo() {
    case "$1" in
        noctalia) echo noctalia ;;
        dms)      echo danklogo ;;
    esac
}


# One colour from the shell's fuzzel colours (themes/shell), turned from
# fuzzel's RRGGBBAA into Qt's #AARRGGBB. Empty when it isn't there.
fuzzel_colour() {
    local hex
    hex="$(sed -n "s/^$1=\([0-9a-fA-F]\{8\}\)$/\1/p" "$CONF_DIR/fuzzel/themes/shell" 2>/dev/null | head -n1)"
    [ -n "$hex" ] && echo "#${hex:6:2}${hex:0:6}"
}

# The menu is a small Quickshell window (~/.config/quickshell/zexos-switcher),
# not fuzzel: fuzzel always has a search box, and one stray key press there
# hid both choices. The window runs `zshell switch` itself when you pick.
menu() {
    # Pressing Mod+Shift+D again closes it.
    qs kill -c zexos-switcher >/dev/null 2>&1 && return 0
    local cur items="" sep=""
    cur="$(current)"
    for s in $SHELLS; do
        installed "$s" || continue
        items+="$sep{\"id\":\"$s\",\"name\":\"$(pretty "$s")\",\"icon\":\"$(logo "$s")\",\"current\":$([ "$s" = "$cur" ] && echo true || echo false)}"
        sep=","
    done
    ZX_ITEMS="[$items]" \
    ZX_BG="$(fuzzel_colour background)" \
    ZX_BORDER="$(fuzzel_colour border)" \
        setsid -f qs -c zexos-switcher >/dev/null 2>&1
}

random_wallpaper() {
    find "$WALL_DIR" -maxdepth 1 -type f \
        \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) \
        2>/dev/null | shuf -n1
}

# Animated wallpapers (videos in ~/Pictures/Wallpapers/Animated) are played
# by Noctalia's video wallpaper plugin, our copy with the `set` command. The
# shell itself still gets a picture, the video's first frame (its "poster"),
# so the colours follow the video too. DMS can't play videos, so under DMS
# only the poster is shown.
is_video() {
    case "$(printf %s "${1##*.}" | tr '[:upper:]' '[:lower:]')" in
        mp4|webm|mkv|mov) return 0 ;;  # keep in step with roller's video_extensions
    esac
    return 1
}

poster() {
    local p="${XDG_CACHE_HOME:-$HOME/.cache}/zexos/posters/$(printf %s "$1" | tr -c 'A-Za-z0-9.-' _).jpg"
    if [ ! -s "$p" ] || [ "$1" -nt "$p" ]; then
        mkdir -p "$(dirname "$p")"
        ffmpeg -loglevel error -y -i "$1" -frames:v 1 -q:v 2 "$p" || return
    fi
    printf '%s\n' "$p"
}

video() { noctalia msg plugin noctalia/mpvpaper:service all "$@"; }

# For a video, the plugin moves to its poster (the first frame) with Noctalia's
# usual transition, then starts the video on top of it. With a video playing,
# a picture also goes through the plugin: it hands the screen back to Noctalia
# before stopping the video, so the transition runs instead of a grey flash.
noctalia_wallpaper() {
    if is_video "$1"; then
        local p; p="$(poster "$1")" || return
        video set "$1"$'\t'"$p"
    elif pgrep -x mpvpaper >/dev/null; then
        video picture "$1"
    else
        noctalia msg wallpaper-set "$1"
    fi
}

# Stop any video, then let Noctalia pick a picture. The plugin turns
# Noctalia's wallpaper back on only once the video player has quit, so retry
# for a moment until Noctalia accepts.
noctalia_random_wallpaper() {
    video clear-all >/dev/null 2>&1
    local i
    for i in $(seq 20); do
        case "$(noctalia msg wallpaper-random)" in error:*) sleep 0.1 ;; *) return 0 ;; esac
    done
    return 1
}

# Noctalia copies each new wallpaper to the login screen by itself (its
# wallpaper_changed hook). DMS has no such hook, so do it here for DMS.
dms_wallpaper() {
    if is_video "$1"; then set -- "$(poster "$1")" || return; fi
    dms ipc call wallpaper set "$1" || return
    "$HOME/.local/bin/sync-sddm-wallpaper.sh" "$1" >/dev/null 2>&1 || true
}

# Mango's shortcut list, for shells that can't show it themselves
# (Noctalia's cheat sheet knows niri and Hyprland, not Mango). Each bind in
# keybinds.conf has its name on the "# ..." line above it.
mango_cheatsheet() {
    pkill -x fuzzel 2>/dev/null && return 0
    awk '
        /^# === / { next }
        /^#/ { desc = substr($0, 3); next }
        /^bind[a-z]*=/ {
            sub(/^bind[a-z]*=/, ""); split($0, f, ",")
            keys = (f[1] == "NONE" ? "" : f[1] "+") f[2]
            gsub(/SUPER/, "Mod", keys); gsub(/CTRL/, "Ctrl", keys)
            gsub(/SHIFT/, "Shift", keys); gsub(/ALT/, "Alt", keys)
            if (desc != "") printf "%-24s %s\n", keys, desc
        }
        { desc = "" }
    ' "$MANGO_DIR/cfg/keybinds.conf" |
        fuzzel --dmenu --prompt 'Shortcuts: ' --width 70 --lines 20 >/dev/null
    return 0
}

# The compositor we run in, for the DMS cheat sheet.
compositor() {
    if [ -n "${MANGO_INSTANCE_SIGNATURE:-}" ]; then echo mangowc
    elif [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then echo hyprland
    else echo niri; fi
}

# One action, sent to the shell in use.
act() {
    local shell="$1" action="$2"; shift 2
    if [ "$shell" = noctalia ]; then
        case "$action" in
            launcher)         noctalia msg panel-toggle launcher ;;
            session)          noctalia msg panel-toggle session ;;
            lock)             noctalia msg session lock ;;
            cheatsheet)
                if [ "$(compositor)" = mangowc ]; then mango_cheatsheet
                else noctalia msg panel-toggle kenn/keybind-cheatsheet:cheatsheet; fi ;;
            wallpaper-random) noctalia_random_wallpaper ;;
            wallpaper-set)    noctalia_wallpaper "$1" ;;
            volume-up)        noctalia msg volume-up ;;
            volume-down)      noctalia msg volume-down ;;
            volume-mute)      noctalia msg volume-mute ;;
            mic-mute)         noctalia msg mic-mute ;;
            media-toggle)     noctalia msg media toggle ;;
            media-next)       noctalia msg media next ;;
            media-prev)       noctalia msg media previous ;;
            brightness-up)    noctalia msg brightness-up ;;
            brightness-down)  noctalia msg brightness-down ;;
            *) return 2 ;;
        esac
    else
        case "$action" in
            launcher)         dms ipc call spotlight toggleWith apps ;;
            session)          dms ipc call powermenu toggle ;;
            lock)             dms ipc call lock lock ;;
            cheatsheet)       dms ipc call keybinds toggle "$(compositor)" ;;
            wallpaper-random) dms_wallpaper "$(random_wallpaper)" ;;
            wallpaper-set)    dms_wallpaper "$1" ;;
            volume-up)        dms ipc call audio increment 5 ;;
            volume-down)      dms ipc call audio decrement 5 ;;
            volume-mute)      dms ipc call audio mute ;;
            mic-mute)         dms ipc call audio micmute ;;
            media-toggle)     dms ipc call mpris playPause ;;
            media-next)       dms ipc call mpris next ;;
            media-prev)       dms ipc call mpris previous ;;
            brightness-up)    dms ipc call brightness increment 5 "" ;;
            brightness-down)  dms ipc call brightness decrement 5 "" ;;
            *) return 2 ;;
        esac
    fi
}

cmd="${1:-}"
[ $# -gt 0 ] && shift
case "$cmd" in
    start)   start ;;
    switch)  switch "$@" ;;
    menu)    menu ;;
    current) current ;;
    relink)  link_kitty "$(current)"; link_theme "$(current)" ;;
    ""|-h|--help) sed -n '2,25p' "$0" | sed 's/^# \{0,1\}//' ;;
    *)
        act "$(current)" "$cmd" "$@"
        rc=$?
        [ $rc -eq 2 ] && echo "zshell: unknown action '$cmd' (see zshell --help)" >&2
        exit $rc
        ;;
esac
