# Runs zexos-dms-sync when DankMaterialShell writes new colours or saves the
# wallpaper you picked. See ~/.local/bin/zexos-dms-sync.
# https://www.freedesktop.org/software/systemd/man/latest/systemd.path.html
[Unit]
Description=ZeXOS: follow DankMaterialShell colour and wallpaper changes

[Path]
PathChanged=%h/.local/share/color-schemes/DankMatugen.colors
PathChanged=%h/.local/state/DankMaterialShell/session.json

[Install]
WantedBy=default.target
