// How things move
//
// ZeXOS defaults: windows zoom in from 80% and zoom out on close,
// workspaces slide with the same bounce. Hyprland and Mango match these.
// To pick another style run `zexos-motion` (it writes ../motion.kdl,
// loaded after this file). Docs: https://yalter.github.io/niri/Configuration:-Animations

animations {
    window-open {
        duration-ms 350
        curve "cubic-bezier" 0.22 1 0.36 1
        custom-shader r"
        vec4 open_color(vec3 coords_geo, vec3 size_geo) {
            float s = mix(0.80, 1.0, niri_progress);
            vec3 c = vec3((coords_geo.xy - 0.5) / s + 0.5, 1.0);
            if (c.x < 0.0 || c.x > 1.0 || c.y < 0.0 || c.y > 1.0) return vec4(0.0);
            vec3 t = niri_geo_to_tex * c;
            return texture2D(niri_tex, t.st) * niri_clamped_progress;
        }
        "
    }
    window-close {
        duration-ms 300
        curve "cubic-bezier" 0.22 1 0.36 1
        custom-shader r"
        vec4 close_color(vec3 coords_geo, vec3 size_geo) {
            float s = mix(1.0, 0.80, niri_clamped_progress);
            vec3 c = vec3((coords_geo.xy - 0.5) / s + 0.5, 1.0);
            if (c.x < 0.0 || c.x > 1.0 || c.y < 0.0 || c.y > 1.0) return vec4(0.0);
            vec3 t = niri_geo_to_tex * c;
            return texture2D(niri_tex, t.st) * (1.0 - niri_clamped_progress);
        }
        "
    }
    workspace-switch {
        duration-ms 450
        curve "cubic-bezier" 0.34 1.3 0.64 1
    }
    horizontal-view-movement {
        duration-ms 450
        curve "cubic-bezier" 0.34 1.3 0.64 1
    }
    window-movement {
        duration-ms 450
        curve "cubic-bezier" 0.34 1.3 0.64 1
    }
    window-resize {
        duration-ms 450
        curve "cubic-bezier" 0.34 1.3 0.64 1
    }
}
