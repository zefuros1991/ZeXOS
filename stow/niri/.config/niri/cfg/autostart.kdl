// Things that start when you log in

// The desktop shell: top bar, launcher, notifications, lock screen.
// zshell starts the one you picked (Noctalia or DankMaterialShell);
// press Mod+Shift+D to change it.
spawn-at-startup "zshell" "start"

// The small window that asks for your password when an app needs admin rights.
spawn-at-startup "/usr/lib/polkit-kde-authentication-agent-1"

// niri normally shows a shortcut cheat sheet at every login. We hide it;
// press Mod+Shift+Escape whenever you want to see it.
hotkey-overlay {
    skip-at-startup
}

// Apps with an autostart entry (in ~/.config/autostart) also start by
// themselves, so you rarely need to add lines here.
