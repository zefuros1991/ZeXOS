// Keyboard, touchpad and mouse
// All options: https://yalter.github.io/niri/Configuration:-Input

input {
    keyboard {
        // Keyboard layout. Empty = use the system layout.
        // Example for English + Greek, switched with Alt+Shift:
        //   layout "us,gr"
        //   options "grp:alt_shift_toggle"
        xkb {
        }

        // Number pad works right after login.
        numlock
    }

    touchpad {
        tap              // a light tap counts as a click
        natural-scroll   // content follows your fingers, like a phone
        // Also handy:
        //   dwt                          -> ignore the touchpad while typing
        //   accel-speed 0.2              -> faster pointer (-1.0 to 1.0)
        //   disabled-on-external-mouse   -> turn it off when a mouse is plugged in
    }

    // Empty = default settings for mice and laptop trackpoints.
    mouse {
    }
    trackpoint {
    }

    // Moving the pointer over a window or screen gives it focus, no click needed.
    focus-follows-mouse

    // Turn this on to make the pointer jump to whichever window you focus
    // with the keyboard:
    // warp-mouse-to-focus
}
