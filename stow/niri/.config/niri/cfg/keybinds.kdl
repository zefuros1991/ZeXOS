// Keyboard shortcuts
//
// "Mod" is the Super key (the one with the Windows logo).
// Each line reads: keys  { what happens; }
// Text in hotkey-overlay-title is the label shown on the Mod+Shift+Escape cheat sheet.
// Shell actions go through `zshell`, so they work the same in Noctalia and
// DankMaterialShell. `zshell --help` lists them.
// All options: https://yalter.github.io/niri/Configuration:-Key-Bindings

binds {
    // ── Help ────────────────────────────────────────────
    Mod+Shift+Escape { show-hotkey-overlay; }
    Mod+F1 hotkey-overlay-title="Shortcut cheat sheet" { spawn "zshell" "cheatsheet"; }

    // ── Open apps ───────────────────────────────────────
    Mod+Space hotkey-overlay-title="App launcher" { spawn "zshell" "launcher"; }
    Mod+C     hotkey-overlay-title="Terminal (kitty)" { spawn "kitty"; }
    Mod+B     hotkey-overlay-title="Web browser (your default)" { spawn-sh "~/.local/bin/zexos-browser"; }
    Mod+E     hotkey-overlay-title="Files (Dolphin)" { spawn "dolphin"; }
    Mod+M     hotkey-overlay-title="Install and update apps" { spawn-sh "~/.local/bin/zexos-app-store"; }

    // ── Wallpaper ───────────────────────────────────────
    // Mod+W opens the roller picker, or closes it if it is already open.
    Mod+W      hotkey-overlay-title="Pick a wallpaper (roller)" { spawn-sh "pkill -x roller || PATH=$HOME/.local/share/roller/bin:$PATH roller"; }
    Mod+Ctrl+W hotkey-overlay-title="Random wallpaper" { spawn "zshell" "wallpaper-random"; }

    // ── Session ─────────────────────────────────────────
    Mod+L      hotkey-overlay-title="Lock the screen" { spawn "zshell" "lock"; }
    Mod+Escape hotkey-overlay-title="Log out / restart / shut down" { spawn "zshell" "session"; }
    Mod+Shift+D hotkey-overlay-title="Change desktop shell (Noctalia / DMS)" { spawn "zshell" "menu"; }
    Mod+Shift+P { power-off-monitors; }   // screens go dark; move the mouse to wake them
    Ctrl+Alt+Delete { quit; }              // leave niri and go back to the login screen

    // ── Laptop keys: sound, music, brightness ───────────
    // allow-when-locked: these work even on the lock screen.
    XF86AudioRaiseVolume  allow-when-locked=true { spawn "zshell" "volume-up"; }
    XF86AudioLowerVolume  allow-when-locked=true { spawn "zshell" "volume-down"; }
    XF86AudioMute         allow-when-locked=true { spawn "zshell" "volume-mute"; }
    XF86AudioMicMute      allow-when-locked=true { spawn "zshell" "mic-mute"; }
    XF86AudioPlay         allow-when-locked=true { spawn "zshell" "media-toggle"; }
    XF86AudioPause        allow-when-locked=true { spawn "zshell" "media-toggle"; }
    XF86AudioNext         allow-when-locked=true { spawn "zshell" "media-next"; }
    XF86AudioPrev         allow-when-locked=true { spawn "zshell" "media-prev"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "zshell" "brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "zshell" "brightness-down"; }

    // ── Windows ─────────────────────────────────────────
    Mod+Q       { close-window; }
    Mod+T       { toggle-window-floating; }   // pop the window out so it floats freely
    Mod+F       { maximize-column; }          // full width, bar stays visible
    Mod+Shift+F { fullscreen-window; }        // whole screen, bar hidden
    Mod+O repeat=false { toggle-overview; }   // zoom out to see every workspace

    // ── Move focus (arrows) ─────────────────────────────
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }
    Mod+Home  { focus-column-first; }
    Mod+End   { focus-column-last; }

    // ── Move the window itself (add Ctrl) ───────────────
    // Arrow keys or the vim keys H J K L both work.
    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+H     { move-column-left; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+L     { move-column-right; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+K     { move-window-up; }
    Mod+Ctrl+Down  { move-window-down; }
    Mod+Ctrl+J     { move-window-down; }
    Mod+Ctrl+Home  { move-column-to-first; }
    Mod+Ctrl+End   { move-column-to-last; }

    // ── Sizes ───────────────────────────────────────────
    Mod+Minus       { set-column-width "-10%"; }    // narrower
    Mod+Equal       { set-column-width "+10%"; }    // wider
    Mod+Shift+Minus { set-window-height "-10%"; }   // shorter
    Mod+Shift+Equal { set-window-height "+10%"; }   // taller
    Mod+Ctrl+F      { expand-column-to-available-width; }   // fill the empty space

    // ── Several screens (add Shift) ─────────────────────
    Mod+Shift+Left  { focus-monitor-left; }
    Mod+Shift+Right { focus-monitor-right; }
    Mod+Shift+Up    { focus-monitor-up; }
    Mod+Shift+Down  { focus-monitor-down; }
    // ...and Shift+Ctrl carries the window with you.
    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+Up    { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Down  { move-column-to-monitor-down; }

    // ── Workspaces ──────────────────────────────────────
    // Workspaces are stacked top to bottom, like floors in a building.
    // Mod+number goes to that floor; Mod+Ctrl+number takes the window along.
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }
    Mod+Tab { focus-workspace-previous; }   // jump back to the last one

    // ── Mouse wheel (hold Mod) ──────────────────────────
    // Up/down changes workspace. cooldown-ms stops one flick from
    // skipping several workspaces at once.
    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }
    // Sideways scroll, or Shift + normal scroll, moves between windows.
    Mod+WheelScrollRight           { focus-column-right; }
    Mod+WheelScrollLeft            { focus-column-left; }
    Mod+Shift+WheelScrollDown      { focus-column-right; }
    Mod+Shift+WheelScrollUp        { focus-column-left; }
    Mod+Ctrl+WheelScrollRight      { move-column-right; }
    Mod+Ctrl+WheelScrollLeft       { move-column-left; }
    Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp   { move-column-left; }

    // ── Screenshots ─────────────────────────────────────
    // Saved to ~/Pictures/Screenshots and copied to the clipboard.
    Mod+Shift+S  { screenshot; }          // drag to pick an area
    Ctrl+Shift+S { screenshot-screen; }   // the whole screen
    Alt+Shift+3  { screenshot-window; }   // just the focused window
}
