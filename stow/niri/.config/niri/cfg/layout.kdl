// How windows are placed and sized
//
// niri puts windows side by side in "columns" on an endless strip that
// scrolls left and right. Think of a row of photos on a table: you slide
// the row instead of stacking photos on top of each other.
// All options: https://yalter.github.io/niri/Configuration:-Layout

layout {
    // Space between windows, in pixels.
    gaps 9

    // Slide a column to the middle only when it would not fit on screen
    // next to the one you came from. Other choices: "never", "always".
    center-focused-column "on-overflow"

    // A lone window sits in the middle instead of hugging the left edge.
    always-center-single-column

    // New windows take half the screen width.
    default-column-width { proportion 0.5; }

    // Fixed widths to cycle through: one third, half, two thirds of the
    // screen. Not bound to a key yet; add `Mod+R { switch-preset-column-width; }`
    // in keybinds.kdl to use them.
    preset-column-widths {
        proportion 0.333
        proportion 0.5
        proportion 0.66667
    }

    // Coloured frame around the focused window. We use `border` below
    // instead, so this one stays off.
    focus-ring {
        off
        width 4
        active-color "#7fc8ff"
        inactive-color "#505050"
    }

    // Frame around every window. The colours here are placeholders:
    // noctalia.kdl replaces them with colours from your wallpaper.
    border {
        width 4
        active-color "#ffc87f"
        inactive-color "#505050"
        urgent-color "#9b0000"
    }

    // Soft shadow under windows. Off for now; add a line with just `on`
    // inside the braces to try it.
    shadow {
        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }

    // Extra empty space at the screen edges. Empty = none.
    struts {
    }
}
