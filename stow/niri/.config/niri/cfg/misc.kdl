// Small settings that don't fit anywhere else

// Ask apps to drop their own title bars, so windows look clean and the
// border draws neatly around them. Restart an app to see the change.
prefer-no-csd

// Where screenshots are saved, named by date and time.
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// Settings passed to every app started from the desktop.
environment {
    QT_QPA_PLATFORMTHEME "qt6ct"   // Qt apps (Dolphin, VLC...) take their look from qt6ct
    QT_SCALE_FACTOR "1.2"          // Qt apps drawn 20% bigger
}

debug {
    // Lets Noctalia bring a window to the front, for example when you
    // click a notification.
    honor-xdg-activation-with-invalid-serial

    // Laptops with two graphics cards: uncomment and fill in to keep niri on
    // the built-in one, so the big one can sleep and save battery.
    // render-drm-device "/dev/dri/by-path/pci-XXXX:XX:XX.X-render"
}
