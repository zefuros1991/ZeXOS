// Per-app tweaks
//
// "window-rule" changes normal app windows.
// "layer-rule" changes Noctalia's own pieces (bar, panels, pop-ups).
// Each rule: `match` says who it applies to, the rest says what changes.
// More: https://yalter.github.io/niri/Configuration:-Window-Rules

// ── All windows ─────────────────────────────────────────

// Rounded corners.
window-rule {
    geometry-corner-radius 14
    clip-to-geometry true
}

// ── Apps ────────────────────────────────────────────────

// Frosted-glass blur behind these apps.
window-rule {
    match app-id="^(kitty|vlc|org.kde.dolphin)$"
    background-effect {
        blur true
    }
}

// Noctalia's settings window floats above the others, with blur.
window-rule {
    match app-id="dev.noctalia.Noctalia"
    open-floating true
    background-effect {
        blur true
        xray false
    }
}

// WezTerm opens at the wrong size unless it picks its own width.
window-rule {
    match app-id=r"^org.wezfurlong.wezterm$"
    default-column-width {
    }
}

// ── Dim unfocused windows ───────────────────────────────

// niri normally paints the border as a solid plate behind the whole window,
// so it shows through see-through windows (kitty, and every dimmed window)
// as a purple-grey haze. Draw it as a frame round the edge only.
window-rule {
    draw-border-with-background false
}

// Windows you're not using are slightly dimmed, so the active one stands
// out. This rule comes after the app rules above so it wins over them.
// niri has no "dim" setting, so we fake one: a solid dark layer sits
// right behind the window (a shadow with no blur or spread), and the window
// turns a little see-through over it. Dark layer + window = a darker
// window, with no wallpaper showing through.
window-rule {
    match is-focused=false
    opacity 0.62
    shadow {
        on
        softness 0
        spread 0
        offset x=0 y=0
        color "#000000"
        inactive-color "#000000"
        draw-behind-window true
    }
    // No frosted glass on them: the blur would sit in front of the dark
    // layer and turn the window grey instead of darker.
    background-effect {
        blur false
    }
}

// kitty is already see-through by itself, so the same setting makes it
// much darker than other apps. It gets a lighter dim so they all match.
window-rule {
    match app-id="^kitty$" is-focused=false
    opacity 0.75
}

// ── Noctalia shell ──────────────────────────────────────

// Blur behind panels, notifications, the dock and volume pop-ups.
// "xray false" = blur what is really behind them, not just the wallpaper.
layer-rule {
    match namespace="^noctalia-(notification|dock|panel|attached-panel|osd)$"
    background-effect {
        xray false
    }
}

// The window switcher doesn't ask for blur, so we switch it on here.
layer-rule {
    match namespace="^noctalia-window-switcher"
    background-effect {
        blur true
        xray false
    }
}

// No blur on the top bar. The bar is one clear strip holding three
// "islands"; blur would smudge the gaps between them.
layer-rule {
    match namespace="^noctalia-bar-"
    background-effect {
        blur false
    }
}

// Blurred wallpaper behind the overview (Mod+O).
layer-rule {
    match namespace="^noctalia-backdrop"
    place-within-backdrop true
}

// ── DankMaterialShell ───────────────────────────────────

// DMS draws its wallpaper on a layer named "quickshell". Put it behind the
// overview too, so Mod+O shows your (blurred) wallpaper instead of grey.
// Same rule as DMS's own niri config.
layer-rule {
    match namespace="^quickshell$"
    place-within-backdrop true
}
