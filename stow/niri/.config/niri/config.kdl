// ZeXOS — niri main file
//
// This file only pulls in the smaller files below, one per topic.
// Change things in those files, not here.
// Full option list: https://yalter.github.io/niri/

include "./cfg/animation.kdl"   // how fast things move
include "./cfg/autostart.kdl"   // programs that start with the desktop
include "./cfg/keybinds.kdl"    // keyboard and mouse shortcuts
include "./cfg/input.kdl"       // keyboard, touchpad, mouse
include "./cfg/layout.kdl"      // gaps, column sizes, borders
include "./cfg/rules.kdl"       // per-app tweaks (blur, rounding, floating)
include "./cfg/misc.kdl"        // screenshots, env vars, small extras

// The animation style you picked with `zexos-motion`, if you changed it.
// Comes after cfg/animation.kdl so it wins. Don't edit it by hand.
include optional=true "./motion.kdl"

// Colours made from your wallpaper. Noctalia rewrites this file on its own,
// so don't edit it. It comes after layout.kdl so its colours win.
include "./noctalia.kdl"

// When you use DankMaterialShell instead, `zshell` writes this file so it
// loads DMS's wallpaper colours, which then win over Noctalia's. With
// Noctalia it is only a comment. Don't edit it by hand.
include optional=true "./shell-colors.kdl"

// Mouse pointer look
cursor {
    xcursor-theme "Bibata-Modern-Ice"
    xcursor-size 24
}

// Your screens (empty until you add something, see the file)
include "monitors.kdl"
